        "http://localhost:3000/contrastEnhanced",
        "http://localhost:3000/visualPresentation",
        "http://localhost:3000/nonTextContrast",
        "http://localhost:3000/textSpacing",
        "http://localhost:3000/keyboard",
        "http://localhost:3000/keyboardTrap",
        "http://localhost:3000/shortcut",
        "http://localhost:3000/timeAdjustable",
        "http://localhost:3000/pauseStopHide",
        "http://localhost:3000/threeFlashes",
        "http://localhost:3000/bypassBlock",
        "http://localhost:3000/focusOrder",
        "http://localhost:3000/linkPurpose",
        "http://localhost:3000/headingsLabels",
